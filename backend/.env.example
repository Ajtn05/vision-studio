VISION_MODEL_PATH=models/yolo11n.pt
VISION_PROVIDER=cpu
VISION_CPU_THREADS=2
# Exact origins, comma separated. Keep only the origins you actually use.
VISION_ALLOWED_ORIGINS=tauri://localhost,http://localhost:1420,http://127.0.0.1:1420
VISION_ALLOW_MISSING_ORIGIN=false
VISION_MAX_MESSAGE_BYTES=1048576
VISION_INFERENCE_TIMEOUT_SECONDS=15
VISION_IDLE_TIMEOUT_SECONDS=30
